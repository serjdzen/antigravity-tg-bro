# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyc

# Virtual Environments
.venv/
venv/
ENV/
env/

# Environment and Secret configuration files
.env
.bot.env
.env.*
!.env.example
*.local

