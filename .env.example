# ==========================================
# Antigravity Telegram Bot - Environment Configuration
# ==========================================

# 1. Telegram Bot Token from @BotFather (Required)
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz

# 2. Allowed Telegram User IDs (Comma-separated) (Required for Security)
# Find your ID via @userinfobot or @raw_data_bot
ALLOWED_USER_IDS=123456789,987654321

# 3. Default UI Language (Optional: 'en' for English [Default], 'ru' for Russian)
BOT_LANGUAGE=en

# 4. Default workspace directory for project exploration (Optional)
# Defaults to $HOME/Documents/work or $HOME/projects
DEFAULT_PROJECTS_DIR=/path/to/your/projects

# 5. Default AI Model (Optional, defaults to gemini-3.1-flash-lite)
# Options: gemini-3.7-flash, gemini-3.1-pro, claude-3-7-sonnet, etc.
DEFAULT_MODEL=gemini-3.1-flash-lite

# 6. Global Antigravity Config Paths (Optional, auto-detected from ~/.gemini)
# MCP_CONFIG_PATH=/path/to/.gemini/config/mcp_config.json
# SKILLS_DIR_PATH=/path/to/.gemini/config/skills

# 7. Google Gemini API Key (Optional for SDK mode fallback)
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 8. Groq Cloud API Key (Optional for Voice Transcription via Whisper Large v3 Turbo)
# Get free key at: https://console.groq.com/keys
GROQ_API_KEY=
